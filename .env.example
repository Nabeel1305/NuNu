APP_NAME="Offline Payment Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=offline_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PLATFORM_CODE_LENGTH=12
# Keyed hash for stored codes; defaults to APP_KEY. Set a separate value in production.
PLATFORM_CODE_PEPPER=
PLATFORM_ALLOW_PRIVATE_WEBHOOK_URLS=false

# Dashboard session cookie: set true behind HTTPS.
SESSION_SECURE_COOKIE=true

# Set to '*' or a comma-separated list of proxy addresses when behind a load balancer.
TRUSTED_PROXIES=

# Dashboard second factor: unset = required in production only; true/false forces it.
PLATFORM_ADMIN_REQUIRE_2FA=

# Recommended in production: Redis for queue, cache and rate limits (database queue deadlocks between workers).
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_CLIENT=predis

# Demo seeder (never runs in production)
# SEED_ADMIN_PASSWORD=password
# SEED_PORTAL_PASSWORD=password
# SEED_DEMO_HISTORY=1
