# Production settings for the Nunu platform on DigitalOcean App Platform (see nunu-app/DEPLOY.md).
# Put these in the App Platform component settings as ENCRYPTED variables. Do not commit real values.

APP_NAME="Nunu Platform"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                  # php artisan key:generate --show
APP_URL=https://nunu.pakapay.ng
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr        # App Platform collects stderr; the container disk is not kept
LOG_LEVEL=info

# Database: DigitalOcean Managed MySQL. It requires TLS, so give the app the CA certificate.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=25060
DB_DATABASE=offline_platform
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=        # path to the cluster's CA certificate inside the container

# Redis (DigitalOcean Managed Redis/Valkey) for queue, cache and rate limits. The image has no phpredis, so use predis.
REDIS_CLIENT=predis
REDIS_URL=rediss://default:PASSWORD@HOST:25061
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Behind App Platform's load balancer, and HTTPS only.
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true

# Dashboard admins must use a second factor.
PLATFORM_ADMIN_REQUIRE_2FA=true

# Stored codes are hashed with this. Set it ONCE to a long random value and never change it:
# changing it makes every outstanding code unredeemable.
PLATFORM_CODE_PEPPER=

# The bank's webhook address is a real public HTTPS address, so private addresses stay refused.
PLATFORM_ALLOW_PRIVATE_WEBHOOK_URLS=false
