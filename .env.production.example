# Production settings for the Nunu platform on DigitalOcean App Platform (see nunu-app/DEPLOY.md).
# Put these in the App Platform component settings as ENCRYPTED variables. Do not commit real values.

APP_NAME="Nunu Platform"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                  # php artisan key:generate --show
APP_URL=https://nunu.pakapay.ng
APP_TIMEZONE=UTC
LOG_CHANNEL=stderr        # App Platform collects stderr; the container disk is not kept
LOG_LEVEL=info

# Database: DigitalOcean Managed MySQL. It requires TLS, so give the app the CA certificate.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=25060
DB_DATABASE=offline_platform
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=        # path to the cluster's CA certificate inside the container

# Redis (DigitalOcean Managed Redis/Valkey) for queue, cache and rate limits. The image has no phpredis, so use predis.
REDIS_CLIENT=predis
REDIS_URL=rediss://default:PASSWORD@HOST:25061
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# Behind App Platform's load balancer, and HTTPS only.
TRUSTED_PROXIES=*
SESSION_SECURE_COOKIE=true

# Dashboard admins must use a second factor.
PLATFORM_ADMIN_REQUIRE_2FA=true

# Stored codes are hashed with this. Set it ONCE to a long random value and never change it:
# changing it makes every outstanding code unredeemable.
PLATFORM_CODE_PEPPER=

# The bank's webhook address is a real public HTTPS address, so private addresses stay refused.
PLATFORM_ALLOW_PRIVATE_WEBHOOK_URLS=false

# Root secret every phone's offline key is derived from. Generate once (openssl rand -hex 32), give the SAME value to the
# web service and both workers, and never change it: changing it breaks every enrolled phone. If left empty the platform
# falls back to a value derived from APP_KEY, which works but ties every phone to APP_KEY.
PLATFORM_DEVICE_KEY_SECRET=

# Optional: tell operators when something breaks (Slack incoming-webhook URL and/or comma-separated emails).
PLATFORM_ALERT_SLACK_WEBHOOK=
PLATFORM_ALERT_EMAILS=

# Running the schedule: either keep a scheduler component running (php artisan schedule:work), OR set a long random token and have an
# external cron service call  POST https://<platform>/cron/tick  every minute with the header  Authorization: Bearer <token>.
PLATFORM_CRON_TOKEN=
# TEMPORARY: false lets /cron/tick be called with no token at all (System health shows it as a problem). Keep true.
PLATFORM_CRON_REQUIRE_TOKEN=true
# true (default): a tick starts the schedule as its own process and answers at once (202), so slow ticks never time the cron service out.
PLATFORM_CRON_BACKGROUND=true
# No separate queue worker component? true = the schedule also drains the queue each minute (webhooks go out within about a minute).
PLATFORM_QUEUE_IN_SCHEDULER=false
